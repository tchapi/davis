{% set authBypassed = not app.user and adminAuthBypass == 'true' %}
{% set admin_logged = (app.user and is_granted("access")) or authBypassed %}
{% set user_logged = (not admin_logged) and app.user and is_granted("access", app.user.getUserId()) %}
{% set user_logged_id = user_logged ? app.user.getUserId() : 0 %}

<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="csrf-token" content="{{ csrf_token('admin_action') }}">
        <title>{% block title %}Davis{% endblock %}</title>
        <script type="text/javascript" src="{{ asset('js/color.mode.toggler.js') }}"></script>
        <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}" />
        <link rel="stylesheet" type="text/css" href="{{ asset('css/style.css') }}">
    </head>
    <body>
        {% include '_partials/navigation.html.twig' %}
        {% include '_partials/flashes.html.twig' %}
        <div class="container">
            {% block body %}{% endblock %}
        </div>
        <script type="text/javascript" src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('js/app.js') }}"></script>
    </body>
</html>
