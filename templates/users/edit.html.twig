{% extends 'base.html.twig' %}
{% set menu = 'resources' %}

{% block body %}

{% if admin_logged %}
{% include '_partials/back_button.html.twig' with { url: path('user_index'), text: "users.back"|trans } %}
{% elseif user_logged %}
{% include '_partials/back_button.html.twig' with { url: path('user_user', {userId: user_logged_id}), text: "users.back"|trans } %}
{% endif %}

{% if username %}
<h1 class="display-4 fw-lighter mb-5">{{ "users.edit"|trans({'username': username }) }}</h1>
{% else %}
<h1 class="display-4 fw-lighter mb-5">{{ "users.new"|trans }}</h1>
{% endif %}

{{ form(form) }}

{% endblock %}
