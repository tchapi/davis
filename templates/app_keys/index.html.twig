{% extends 'base.html.twig' %}
{% set menu = 'app_keys' %}

{% block body %}

<h1 class="display-4 d-flex fw-lighter justify-content-between">{{ "title.app_keys"|trans }}<a href="{{ path('app_key_create') }}" class="btn btn-sm btn-success mb-auto mt-auto">+ {{ "app_keys.new"|trans }}</a></h1>

{% if created %}
<div id="app-key-secret" class="alert alert-success mt-4">
    <h5>{{ "app_keys.secret.title"|trans({'name': created.name}) }}</h5>
    <p class="mb-1">{{ "app_keys.app_id"|trans }} : <code class="app-id">{{ created.appId }}</code></p>
    <p class="mb-1"><code class="app-secret">{{ created.secret }}</code></p>
    <p class="mb-1">{{ "app_keys.secret.username"|trans({'appId': created.appId}) }}</p>
    <p class="mb-0 fw-bold">{{ "app_keys.secret.text"|trans }}</p>
</div>
{% endif %}

<div class="list-group mt-4">
{% for key in keys %}
    <div class="list-group-item p-3">
        <div class="d-flex w-100 justify-content-between">
            <h5 class="me-auto">{{ key.name }}
            {% if key.revokedAt is null %}
                <span class="badge bg-success">{{ "app_keys.status.active"|trans }}</span>
            {% elseif key.revokedAt > now %}
                <span class="badge bg-warning text-dark">{{ "app_keys.status.expires"|trans({'date': key.revokedAt|date('Y-m-d H:i')}) }}</span>
            {% else %}
                <span class="badge bg-secondary">{{ "app_keys.status.revoked"|trans({'date': key.revokedAt|date('Y-m-d H:i')}) }}</span>
            {% endif %}
            </h5>

            {% if key.isActive(now) %}
            <div class="me-0 text-right">
                <a href="#"
                    data-bs-toggle="modal" data-bs-target="#deleteModal-app_keys"
                    data-href="{{ path('app_key_revoke', {id: key.id}) }}"
                    class="btn btn-sm btn-outline-danger"
                    data-flavour="app_keys"
                >{{ "app_keys.revoke"|trans }}</a>
            </div>
            {% endif %}
        </div>
        <p class="mb-1">{{ "app_keys.app_id"|trans }} : <code class="app-id">{{ key.appId }}</code></p>
        <p class="mb-1">{{ "app_keys.scope"|trans }} : {% if key.isAllUsers %}<span class="badge bg-primary">{{ "app_keys.scope.all"|trans }}</span> {% endif %}{% if key.namedUsers %}<code>{{ key.namedUsers|join(', ') }}</code>{% endif %}</p>
        {% set keyUsages = usages[key.id] ?? [] %}
        <p class="mb-1">{{ "app_keys.used_as"|trans }} :
        {% for usage in keyUsages|slice(0, 10) %}<code title="{{ usage.firstUsedAt|date('Y-m-d H:i') }} → {{ usage.lastUsedAt|date('Y-m-d H:i') }}">{{ usage.login }}</code>{% if not loop.last %}, {% endif %}{% else %}{{ "app_keys.never"|trans }}{% endfor %}
        {% if keyUsages|length > 10 %}{{ "app_keys.used_as.more"|trans({'count': keyUsages|length - 10}) }}{% endif %}
        </p>
        <small>{{ "app_keys.created"|trans }} {{ key.createdAt|date('Y-m-d H:i') }} · {{ "app_keys.last_used"|trans }} {{ key.lastUsedAt ? key.lastUsedAt|date('Y-m-d H:i') : 'app_keys.never'|trans }}</small>
    </div>
{% else %}
    <div id="no-app-key" class="my-5 py-5 d-flex justify-content-center align-items-center text-muted">{{ "no.app_keys.yet"|trans }}</div>
{% endfor %}
</div>

{% include '_partials/delete_modal.html.twig' with {flavour: 'app_keys'} %}

{% endblock %}
