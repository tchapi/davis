{% extends 'base.html.twig' %}
{% set menu = 'dashboard' %}

{% block body %}

<h1 class="display-4 fw-lighter">{{ "title.dashboard"|trans }}</h1>

<div class="row">
  <div class="col-md">
    <h3 class="mb-3 mt-4 capabilities">{{ "dashboard.capabilities"|trans }}</h3>

    <ul class="list-group">
      {% if calDAVEnabled %}
      <li class="list-group-item d-flex justify-content-between align-items-center list-group-item-success">CalDAV
        <span class="badge bg-success rounded-pill">{{ "enabled"|trans }}</span></li>
      {% else %}
      <li class="list-group-item d-flex justify-content-between align-items-center list-group-item-danger">CalDAV
        <span class="badge bg-danger rounded-pill">{{ "disabled"|trans }}</span></li>
      {% endif %}

      {% if cardDAVEnabled %}
      <li class="list-group-item d-flex justify-content-between align-items-center list-group-item-success">CardDAV
        <span class="badge bg-success rounded-pill">{{ "enabled"|trans }}</span></li>
      {% else %}
      <li class="list-group-item d-flex justify-content-between align-items-center list-group-item-danger">CardDAV
        <span class="badge bg-danger rounded-pill">{{ "disabled"|trans }}</span></li>
      {% endif %}

      {% if webDAVEnabled %}
      <li class="list-group-item d-flex justify-content-between align-items-center list-group-item-success">WebDAV
        <span class="badge bg-success rounded-pill">{{ "enabled"|trans }}</span></li>
      {% else %}
      <li class="list-group-item d-flex justify-content-between align-items-center list-group-item-danger">WebDAV
        <span class="badge bg-danger rounded-pill">{{ "disabled"|trans }}</span></li>
      {% endif %}
    </ul>

    <h3 class="mb-3 mt-4 health">{{ "dashboard.health"|trans }}</h3>

    <ul class="list-group">
      <li class="list-group-item d-flex justify-content-between align-items-center{% if attentionCount > 0 %} list-group-item-warning{% endif %}">
        <span>{% if attentionCount > 0 %}{{ "dashboard.attention"|trans({'%count%': attentionCount}) }}{% else %}{{ "dashboard.attention.none"|trans }}{% endif %}</span>
        <a href="{{ path('diagnostics') }}" class="btn btn-sm btn-outline-secondary">{{ "dashboard.attention.go"|trans }}</a>
      </li>
    </ul>
  </div>

  <div class="col-md">
    <h3 class="mb-3 mt-4 objects">{{ "dashboard.objects"|trans }}</h3>

    <ul class="list-group mb-5">
      <li class="list-group-item d-flex justify-content-between align-items-center">
        {{ "dashboard.users"|trans }} <span class="badge bg-primary rounded-pill">{{ usersCount }}</span>
      </li>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>{{ "dashboard.calendars"|trans }}&nbsp;<span class="small text-muted ms-1 me-auto">{{ "dashboard.calendars.help"|trans }}</span></div> <span class="badge bg-primary rounded-pill">{{ calendarsCount }}</span>
      </li>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        ↳ {{ "dashboard.events"|trans }} <span class="badge bg-secondary rounded-pill">{{ eventsCount }}</span>
      </li>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        {{ "dashboard.address_books"|trans }} <span class="badge bg-primary rounded-pill">{{ addressBooksCount }}</span>
      </li>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        ↳ {{ "dashboard.contacts"|trans }} <span class="badge bg-secondary rounded-pill">{{ contactsCount }}</span>
      </li>
    </ul>
  </div>
</div>

{% endblock %}