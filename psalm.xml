<?xml version="1.0"?>
<!--
  errorLevel 3: everything except Mixed*, Deprecated*, MissingParamType and PropertyNotSetInConstructor.
  ensureOverrideAttribute is off while the minimum PHP is 8.2 (#[\Override] is only enforced from 8.3);
  Psalm can add the attributes itself (alter mode, issue MissingOverrideAttribute) when that changes.
-->
<psalm
    errorLevel="3"
    resolveFromConfigFile="true"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
    ensureOverrideAttribute="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    errorBaseline="psalm-baseline.xml"
>
    <projectFiles>
        <directory name="src" />
        <directory name="tests" />
        <ignoreFiles>
            <directory name="vendor" />
            <!-- Generated by Doctrine, not hand-maintained -->
            <directory name="migrations" />
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <!-- Bundled with Psalm 7: ContainerInterface::get() types, #[Required] props, console input types, Symfony taint sinks -->
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin" />
        <!-- Doctrine ORM collection/repository generics -->
        <pluginClass class="Weirdan\DoctrinePsalmPlugin\Plugin" />
    </plugins>

    <issueHandlers>
        <!-- sabre/vobject components expose their iCalendar/vCard properties through __get/__set,
             by design for any property name, so there is nothing to declare on the classes. -->
        <UndefinedMagicPropertyFetch>
            <errorLevel type="suppress">
                <referencedProperty name="Sabre\VObject\Component::$DTSTART" />
                <referencedProperty name="Sabre\VObject\Component::$DTEND" />
                <referencedProperty name="Sabre\VObject\Component::$SUMMARY" />
                <referencedProperty name="Sabre\VObject\Component\VCalendar::$VEVENT" />
                <referencedProperty name="Sabre\VObject\Component\VCard::$UID" />
                <referencedProperty name="Sabre\VObject\Document::$VEVENT" />
                <referencedProperty name="Sabre\VObject\Document::$VAVAILABILITY" />
            </errorLevel>
        </UndefinedMagicPropertyFetch>
        <UndefinedMagicPropertyAssignment>
            <errorLevel type="suppress">
                <referencedProperty name="Sabre\VObject\Component::$DTSTART" />
                <referencedProperty name="Sabre\VObject\Component::$DTEND" />
                <referencedProperty name="Sabre\VObject\Component\VCalendar::$VERSION" />
                <referencedProperty name="Sabre\VObject\Component\VCalendar::$PRODID" />
            </errorLevel>
        </UndefinedMagicPropertyAssignment>
    </issueHandlers>

    <taintAnalysis>
        <ignoreFiles>
            <directory name="tests" />
        </ignoreFiles>
    </taintAnalysis>
</psalm>
